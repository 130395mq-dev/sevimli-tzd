<?xml version="1.0" encoding="utf-8"?>
<!--
    Qabul / ko'chirish / sanoq qatori:
    tartib raqami + (nom / holat) + miqdor.

    6.6: ID lar O'ZGARMADI (rowBody, rowNum, rowName, rowStatus, rowQty),
    shuning uchun RecvRowAdapter va uni ishlatadigan barcha ekranlar
    avvalgidek ishlaydi.

    Nima o'zgardi va nega:
      - qator balandligi 64dp dan kam emas — qo'lqop bilan aniq bosiladi;
      - tovar nomi 15sp dan 16.5sp ga — xodim ombor yorug'ida nomni
        uzoqdan o'qiy olsin;
      - miqdor 17sp dan 19sp ga va tnum — raqamlar ustun bo'lib tekis turadi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:paddingLeft="10dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/rowNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="28dp"
            android:gravity="center"
            android:paddingLeft="4dp"
            android:paddingRight="6dp"
            android:textSize="13sp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_gray" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16.5sp"
                android:textColor="@color/text_dark" />

            <TextView
                android:id="@+id/rowStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:textSize="13sp"
                android:textColor="@color/text_gray" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/card_stroke" />
</LinearLayout>
