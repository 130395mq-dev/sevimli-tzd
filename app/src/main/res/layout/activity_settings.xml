<?xml version="1.0" encoding="utf-8"?>
<!--
  SOZLAMALAR.

  O'ZGARISH — faqat ko'rinish. BARCHA ID lar o'sha-o'sha qoldi:
    btnBack, loginStage, inLogin, inPassword, btnLogin, loginError,
    storeStage, fnList, inToken, btnSaveToken, btnOrg, swUlgurji,
    storeList, loading
  Ya'ni SettingsActivity.kt ga tegilmadi.

  Ilgari bularning hammasi bitta uzun ro'yxat edi va tartib tasodifiy:
  Bo'limlar -> Token -> Organizatsiya -> Narx -> Sklad. Endi ma'no
  bo'yicha bo'limlarga ajratildi va tartib ish mantiq'iga moslashtirildi:
  avval "kim/qayerda ishlaydi", oxirida texnik token.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- ==================== SARLAVHA ==================== -->
    <LinearLayout style="@style/Head">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Head.Back"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:tint="@color/white"
            android:contentDescription="Orqaga" />

        <TextView
            style="@style/T.Title.OnBrand"
            android:layout_marginStart="@dimen/sp_1"
            android:text="Sozlamalar" />
    </LinearLayout>

    <!-- ==================== MENEJER KIRISHI ==================== -->
    <LinearLayout
        android:id="@+id/loginStage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sp_6">

        <TextView
            style="@style/T.Title"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sp_5"
            android:layout_marginBottom="@dimen/sp_1"
            android:text="Menejer kirishi" />

        <TextView
            style="@style/T.Sub"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/sp_6"
            android:text="Sozlamani faqat menejer o'zgartiradi" />

        <EditText
            android:id="@+id/inLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Login"
            android:inputType="text"
            android:textSize="@dimen/ts_body"
            android:background="@drawable/bg_chip"
            android:paddingStart="@dimen/sp_4"
            android:paddingEnd="@dimen/sp_4"
            android:layout_marginBottom="@dimen/sp_3"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/inPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Parol"
            android:inputType="textPassword"
            android:textSize="@dimen/ts_body"
            android:background="@drawable/bg_chip"
            android:paddingStart="@dimen/sp_4"
            android:paddingEnd="@dimen/sp_4"
            android:layout_marginBottom="@dimen/sp_5"
            android:importantForAutofill="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Btn.Primary"
            android:text="Kirish" />

        <TextView
            android:id="@+id/loginError"
            style="@style/T.Sub"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/sp_3"
            android:gravity="center"
            android:textColor="@color/brand"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ==================== SOZLAMALAR (kirgandan keyin) ==================== -->
    <ScrollView
        android:id="@+id/storeStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:padding="@dimen/screen_pad"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- = TASHKILOT = -->
            <TextView style="@style/T.Section"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Tashkilot" />

            <androidx.cardview.widget.CardView style="@style/Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sp_4">

                    <TextView style="@style/T.Body.Bold" android:text="Organizatsiya" />
                    <TextView style="@style/T.Sub"
                        android:layout_marginTop="2dp"
                        android:text="Hujjatlar qaysi yuridik shaxs nomidan yoziladi" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrg"
                        style="@style/Btn.Ghost"
                        android:layout_marginTop="@dimen/sp_3"
                        android:text="Organizatsiyani tanlash" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- = NARX TURI = -->
            <TextView style="@style/T.Section"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginTop="@dimen/sp_5"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Narx turi" />

            <androidx.cardview.widget.CardView style="@style/Card">
                <LinearLayout style="@style/RowInner">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/T.Body.Bold" android:text="Ulgurji narx" />
                        <TextView style="@style/T.Sub"
                            android:layout_marginTop="2dp"
                            android:text="Optom savdo filiali uchun" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swUlgurji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sp_3" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- = OMBOR = -->
            <TextView style="@style/T.Section"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginTop="@dimen/sp_5"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Ombor" />

            <TextView style="@style/T.Sub"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Qurilma qaysi skladga ishlaydi. Tanlangan sklad barcha bo'limga amal qiladi." />

            <!-- Sklad kartochkalari KODDAN qo'yiladi (SettingsActivity) -->
            <LinearLayout
                android:id="@+id/storeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- = DASHBOARD = -->
            <TextView style="@style/T.Section"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginTop="@dimen/sp_5"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Dashboard" />

            <TextView style="@style/T.Sub"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Bosh sahifada qaysi bo'limlar ko'rinsin" />

            <androidx.cardview.widget.CardView style="@style/Card">
                <!-- Bo'lim qatorlari KODDAN qo'yiladi (SettingsActivity) -->
                <LinearLayout
                    android:id="@+id/fnList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sp_4"
                    android:paddingEnd="@dimen/sp_4"
                    android:paddingTop="@dimen/sp_1"
                    android:paddingBottom="@dimen/sp_1" />
            </androidx.cardview.widget.CardView>

            <!-- = QURILMA = -->
            <TextView style="@style/T.Section"
                android:layout_marginStart="@dimen/sp_1"
                android:layout_marginTop="@dimen/sp_5"
                android:layout_marginBottom="@dimen/sp_2"
                android:text="Qurilma" />

            <androidx.cardview.widget.CardView style="@style/Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sp_4">

                    <TextView style="@style/T.Body.Bold" android:text="Qurilma tokeni" />
                    <TextView style="@style/T.Sub"
                        android:layout_marginTop="2dp"
                        android:text="Kabinetdan olingan kalit. Uni hech kimga bermang." />

                    <EditText
                        android:id="@+id/inToken"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="@dimen/sp_3"
                        android:hint="Token"
                        android:inputType="text"
                        android:textSize="@dimen/ts_sub"
                        android:fontFamily="monospace"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="@dimen/sp_4"
                        android:paddingEnd="@dimen/sp_4"
                        android:importantForAutofill="no" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveToken"
                        style="@style/Btn.Ghost"
                        android:layout_marginTop="@dimen/sp_3"
                        android:text="Tokenni saqlash" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/sp_6" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sp_4"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />
</LinearLayout>
