<?xml version="1.0" encoding="utf-8"?>
<!--
  Mahsulot qidirish — 6.7 dizayni. Funksiya va ID lar O'ZGARMADI, faqat ko'rinish.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                style="@style/J.HeadTitle"
                android:text="@string/product_search" />

            <TextView
                style="@style/J.HeadSub"
                android:layout_marginTop="1dp"
                android:text="@string/search_by_fields" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/search"
            style="@style/J.Field"
            android:hint="@string/name_or_code_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingEnd="52dp"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="#9BB3A7"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="@string/clear" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <TextView
            android:id="@+id/hintTitle"
            style="@style/J.Body"
            android:text="@string/search_by_name_code" />

        <TextView
            android:id="@+id/hintSub"
            style="@style/J.Sub"
            android:layout_marginTop="5dp"
            android:text="@string/example_code" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="12dp"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp" />
    </ScrollView>
</LinearLayout>
