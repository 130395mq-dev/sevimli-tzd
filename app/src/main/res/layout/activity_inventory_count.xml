<?xml version="1.0" encoding="utf-8"?>
<!--
  MoySklad'da yaratilgan inventarizatsiyani sanash ekrani — 6.6 dizayni.

  Funksiya va mantiq O'ZGARMADI. ID lar avvalgidek: btnBack, headerName,
  headerRoute, btnAdd, scanInput, progressText, loading, list, btnConfirm.

  O'zgargani: teginish maydonlari 48dp, ro'yxat kartochka ichida,
  sarlavha qatori tinchroq. Farq (kamomad / ortiqcha) allaqachon har
  qatorda yozilardi — u joyida qoldi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Orqaga" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/headerName"
                style="@style/J.HeadTitle"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Инвентаризация" />

            <TextView
                android:id="@+id/headerRoute"
                style="@style/J.HeadSub"
                android:layout_marginTop="1dp"
                android:text="—" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_plus"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Qo'lda qo'shish" />
    </LinearLayout>

    <!-- Skaner kiritishi — ko'rinmaydi, fokusni ushlab turadi -->
    <EditText
        android:id="@+id/scanInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:background="@null"
        android:importantForAutofill="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:background="@drawable/j_field">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/j_ic_scan"
            app:tint="#9BB3A7"
            android:contentDescription="Skan" />

        <TextView
            style="@style/J.Body"
            android:layout_marginStart="10dp"
            android:textColor="#9BB3A7"
            android:text="Shtrix-kodni skanerlang" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/progressText"
            style="@style/J.Sec"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Sanalgan: 0 / 0" />

        <TextView
            style="@style/J.Sec"
            android:text="Fakt" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="12dp"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/j_card"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        style="@style/J.Btn.Primary"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:text="Sanoqni saqlash" />
</LinearLayout>
