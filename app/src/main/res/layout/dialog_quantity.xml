<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/j_dialog_bg">

    <TextView
        android:id="@+id/qName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/qPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/brand"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/qPackInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/brand_tint"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/brand_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/qWas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/was_zero"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/qWill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/will_one"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btnMinus"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="@string/minus"
            android:textColor="@color/brand"
            android:textSize="30sp"
            android:background="@drawable/j_stepper" />

        <EditText
            android:id="@+id/qInput"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true"
            android:text="@string/one"
            android:textColor="@color/text_dark"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:background="@drawable/j_field" />

        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="@string/plus"
            android:textColor="@color/brand"
            android:textSize="28sp"
            android:background="@drawable/j_stepper" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/brand"
        app:cornerRadius="14dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
