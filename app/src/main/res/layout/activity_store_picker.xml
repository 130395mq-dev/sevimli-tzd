<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <LinearLayout style="@style/Head">

        <ImageView
            android:id="@+id/btnBack"
            style="@style/Head.Back"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:tint="@color/white"
            android:contentDescription="Orqaga" />

        <TextView
            android:id="@+id/title"
            style="@style/T.Title.OnBrand"
            android:layout_marginStart="@dimen/sp_1"
            android:text="Qayerga (sklad)" />
    </LinearLayout>

    <TextView
        style="@style/T.Sub"
        android:layout_marginStart="@dimen/sp_5"
        android:layout_marginEnd="@dimen/sp_5"
        android:layout_marginTop="@dimen/sp_4"
        android:text="Qaysi sklad bilan ishlaysiz?" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_pad"
            android:paddingTop="@dimen/sp_2" />
    </ScrollView>
</LinearLayout>
