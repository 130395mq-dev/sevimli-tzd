<?xml version="1.0" encoding="utf-8"?>
<!--
  SOZLAMALAR — 6.6 dizayni.

  MUHIM: birorta funksiya olib tashlanmadi va qo'shilmadi. Barcha ID lar
  avvalgidek: inLogin, inPassword, btnLogin, loginError, fnList, inToken,
  btnSaveToken, btnOrg, swUlgurji, storeList, loading.

  O'zgargani — joylashuv: ilgari hamma bo'lim bitta uzun scrollда ochiq
  turardi va xodim kerakli joyni izlab aylantirar edi. Endi 5 ta bo'lim
  yig'ilgan holda turadi, bosilganda O'SHA YERDA ochiladi. Yangi ekran
  ham, yangi navigatsiya ham yo'q.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- ==================== SARLAVHA ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- 48dp teginish maydoni: qo'lqop bilan ham beriladi -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <TextView
            style="@style/J.HeadTitle"
            android:layout_marginStart="4dp"
            android:text="@string/settings_title" />
    </LinearLayout>

    <!-- ==================== 1-BOSQICH: MENEJER KIRISHI ==================== -->
    <ScrollView
        android:id="@+id/loginStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <!-- Ilovaning O'Z logosi. Oq fonda och yashil ko'rinmasligi
                 uchun to'q yashil plitka ustiga qo'yilgan. -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/j_logo_tile">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/logo" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="@string/mgr_login_title"
                android:textColor="@color/text_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                style="@style/J.Sub"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="26dp"
                android:text="@string/mgr_login_sub" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/j_ic_user"
                    app:tint="#9BB3A7"
                    android:contentDescription="@string/login" />

                <EditText
                    android:id="@+id/inLogin"
                    style="@style/J.Field"
                    android:hint="@string/login"
                    android:inputType="text"
                    android:paddingStart="48dp"
                    android:autofillHints="username" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/j_ic_lock"
                    app:tint="#9BB3A7"
                    android:contentDescription="@string/password" />

                <EditText
                    android:id="@+id/inPassword"
                    style="@style/J.Field"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:paddingEnd="52dp"
                    android:autofillHints="password" />

                <!-- Parolni ko'rish: xodim uzun parolni xato yozganini
                     tekshira olsin, qayta-qayta urinmasin. -->
                <ImageView
                    android:id="@+id/btnEye"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="14dp"
                    android:src="@drawable/j_ic_eye_off"
                    app:tint="#9BB3A7"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show_password" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/J.Btn.Primary"
                android:layout_marginTop="20dp"
                android:text="@string/sign_in" />

            <TextView
                android:id="@+id/loginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/warning"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== 2-BOSQICH: SOZLAMALAR ==================== -->
    <ScrollView
        android:id="@+id/storeStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ==== 1. BO'LIMLAR ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowFn"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_sections"
                        app:tint="@color/brand"
                        android:contentDescription="@string/sections" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="@string/sections" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/sections_sub" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrFn"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="@string/open" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxFn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <TextView style="@style/J.Sub"
                        android:layout_marginBottom="4dp"
                        android:text="@string/sections_note" />

                    <LinearLayout
                        android:id="@+id/fnList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 2. QURILMA ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowDev"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_device"
                        app:tint="@color/brand"
                        android:contentDescription="@string/device" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="@string/device" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/device_token" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrDev"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="@string/open" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/inToken"
                        style="@style/J.Field"
                        android:hint="@string/device_token_hint"
                        android:inputType="text"
                        android:autofillHints="password" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveToken"
                        style="@style/J.Btn.Primary"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/save_token" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 3. TASHKILOT ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowOrg"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_org"
                        app:tint="@color/brand"
                        android:contentDescription="@string/organization" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="@string/organization" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/organization_sub" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrOrg"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="@string/open" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxOrg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrg"
                        style="@style/J.Btn.Soft"
                        android:text="@string/organization_pick" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 4. NARX TURI ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowPrice"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_price"
                        app:tint="@color/brand"
                        android:contentDescription="@string/price_type" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="@string/price_type" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/price_type_sub" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrPrice"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="@string/open" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView style="@style/J.Sub"
                        android:layout_marginBottom="8dp"
                        android:text="@string/price_type_note" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/J.Body" android:text="@string/price_wholesale" />
                            <TextView style="@style/J.Sub"
                                android:layout_marginTop="2dp"
                                android:text="@string/price_wholesale_sub" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swUlgurji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 5. OMBOR (SKLAD) ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowStore"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_store"
                        app:tint="@color/brand"
                        android:contentDescription="@string/store" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="@string/store" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="@string/store_sub" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrStore"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="@string/open" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/J.Sub"
                        android:layout_marginBottom="6dp"
                        android:text="@string/store_note" />

                    <LinearLayout
                        android:id="@+id/storeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
            <!-- ==== 6. TIL ====
                 Menejer kirgandan keyin ko'rinadi: bu ham qurilma
                 sozlamasi, xodim o'zboshimchalik bilan almashtirmasin. -->
            <LinearLayout
                android:id="@+id/rowLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/j_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/J.IconBox"
                    android:src="@drawable/j_ic_lang"
                    app:tint="@color/brand"
                    android:contentDescription="@string/lang_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView style="@style/J.Body.Bold" android:text="@string/lang_title" />
                    <TextView style="@style/J.Sub"
                        android:layout_marginTop="2dp"
                        android:text="@string/lang_sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/langValue"
                    style="@style/J.Body"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/brand" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#9BB3A7"
                    android:contentDescription="@string/open" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />
</LinearLayout>
