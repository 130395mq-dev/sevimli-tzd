<?xml version="1.0" encoding="utf-8"?>
<!--
  ПРИЁМКА — 6.6 dizayni.

  Funksiya o'zgarmadi. ID lar avvalgidek: btnBack, btnFinish, scanInput,
  totalCount, btnManualAdd, emptyHint, list, loading, totalSum.
  Yangisi bitta: btnFinishBig — pastdagi katta tugma, u ham
  finishDocument() ni chaqiradi (yuqoridagi ✓ bilan bir xil amal).

  Nega pastda tugma: TSD ekrani baland, xodim qurilmani bir qo'lda ushlaydi.
  Yuqoridagi kichkina ✓ ga bosh barmoq yetmaydi — hujjatni yakunlash uchun
  qurilmani qo'lда siljitishga to'g'ri kelardi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- ==================== SARLAVHA ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="6dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                style="@style/J.HeadTitle"
                android:text="@string/supply" />

            <TextView
                android:id="@+id/headerCp"
                style="@style/J.HeadSub"
                android:layout_marginTop="1dp"
                android:text="@string/dash" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnFinish"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_check"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/finish" />
    </LinearLayout>

    <!-- Skaner kiritishi — ko'rinmaydi, fokusni ushlab turadi -->
    <EditText
        android:id="@+id/scanInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:background="@null"
        android:importantForAutofill="no" />

    <!-- ==================== SKAN QATORI ====================
         Chapda — nima qilish kerakligi, o'ngda "Qo'lda qo'shish".
         Ilgari "Qo'lda qo'shish" alohida keng qator edi va ro'yxatdan
         joy o'g'irlardi. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/j_field">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/j_ic_scan"
            app:tint="#9BB3A7"
            android:contentDescription="@string/scan" />

        <TextView
            style="@style/J.Body"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="#9BB3A7"
            android:text="@string/scan_barcode_hyph" />

        <LinearLayout
            android:id="@+id/btnManualAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/j_tag"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/brand"
                android:contentDescription="@string/search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/manual"
                android:textColor="@color/brand"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== HISOB QATORI ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/totalCount"
            style="@style/J.Sec"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/total_items_zero" />

        <TextView
            style="@style/J.Sec"
            android:text="@string/fact_ru" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="34dp"
        android:text="@string/empty_scan_product"
        android:textColor="@color/text_gray"
        android:textSize="15sp" />

    <!-- Ro'yxat RecyclerView'da: faqat ko'rinib turgan qatorlar
         chiziladi va surilganda qayta ishlatiladi. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/j_card"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="10dp"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />

    <!-- ==================== SUMMA ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/j_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/J.Sub"
            android:text="@string/supply_sum" />

        <TextView
            android:id="@+id/totalSum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/zero_sum"
            android:textColor="@color/brand"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <!-- Asosiy amal doim pastda — bosh barmoq yetadigan joyda -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinishBig"
        style="@style/J.Btn.Primary"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:text="@string/supply_finish" />
</LinearLayout>
