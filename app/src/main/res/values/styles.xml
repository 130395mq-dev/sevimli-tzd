<?xml version="1.0" encoding="utf-8"?>
<!--
  JAMLOV DIZAYN TIZIMI — stillar.

  Har bir ekran shu stillardan foydalanadi. Layoutlarда endi
  `android:textSize`, `android:textColor` qo'lda yozilmaydi —
  `style="@style/T.Body"` deb yoziladi.

  Nomlash:
    T.*      — matn (Text)
    Card.*   — kartochka
    Btn.*    — tugma
    Head.*   — sahifa sarlavhasi
-->
<resources>

    <!-- ==================== MATN ==================== -->

    <style name="T">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Ekran sarlavhasi: "Приёмка", "Инвентаризация" -->
    <style name="T.Title" parent="T">
        <item name="android:textSize">@dimen/ts_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Oq header ustidagi sarlavha -->
    <style name="T.Title.OnBrand" parent="T.Title">
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Bo'lim sarlavhasi: "Tovar", "Nazorat" -->
    <style name="T.Section" parent="T">
        <item name="android:textSize">@dimen/ts_micro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_gray</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="T.Body" parent="T">
        <item name="android:textSize">@dimen/ts_body</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <style name="T.Body.Bold" parent="T.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="T.Sub" parent="T">
        <item name="android:textSize">@dimen/ts_sub</item>
        <item name="android:textColor">@color/text_gray</item>
    </style>

    <style name="T.Sub.OnBrand" parent="T.Sub">
        <item name="android:textColor">@color/white70</item>
    </style>

    <!-- "Bugungi ishlar" lentasidagi raqam. tnum — raqamlar bir xil
         kenglikda, shuning uchun lenta siljiganda ular sakramaydi. -->
    <style name="T.TodayNum" parent="T">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="T.Micro" parent="T">
        <item name="android:textSize">@dimen/ts_micro</item>
        <item name="android:textColor">@color/text_gray</item>
    </style>

    <!-- Raqam: qoldiq, miqdor, narx. Bir xil kenglikdagi raqamlar —
         ro'yxatda ustun bo'lib tekis turadi. -->
    <style name="T.Num" parent="T">
        <item name="android:textSize">@dimen/ts_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- ==================== KARTOCHKA ==================== -->

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">@dimen/r_md</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Dashboard funksiya qatori: ikonka | nom+izoh | strelka -->
    <style name="Card.Row" parent="Card">
        <item name="android:layout_marginBottom">@dimen/sp_2</item>
    </style>

    <style name="RowInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_h</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/sp_3</item>
        <item name="android:paddingEnd">@dimen/sp_3</item>
        <item name="android:paddingTop">@dimen/sp_3</item>
        <item name="android:paddingBottom">@dimen/sp_3</item>
    </style>

    <!-- Ikonka atrofidagi yumshoq kvadrat -->
    <style name="IconBox">
        <item name="android:layout_width">@dimen/ic_box</item>
        <item name="android:layout_height">@dimen/ic_box</item>
        <item name="android:background">@drawable/bg_icon_box</item>
    </style>

    <style name="IconBox.Img">
        <item name="android:layout_width">@dimen/ic_md</item>
        <item name="android:layout_height">@dimen/ic_md</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!-- ==================== TUGMA ==================== -->

    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/btn_h</item>
        <item name="android:textSize">@dimen/ts_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/r_md</item>
    </style>

    <style name="Btn.Primary" parent="Btn">
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Btn.Ghost" parent="Btn">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/brand</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== SAHIFA SARLAVHASI ==================== -->

    <!-- Yashil header — operatsiya ekranlari uchun -->
    <style name="Head">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_header</item>
        <item name="android:paddingStart">@dimen/sp_2</item>
        <item name="android:paddingEnd">@dimen/sp_4</item>
        <item name="android:paddingTop">@dimen/sp_3</item>
        <item name="android:paddingBottom">@dimen/sp_4</item>
    </style>

    <!-- Orqaga tugmasi: 48dp teginish maydoni -->
    <style name="Head.Back">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:padding">@dimen/sp_3</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- ==================== HOLAT BELGISI ==================== -->

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/ts_micro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/sp_2</item>
        <item name="android:paddingEnd">@dimen/sp_2</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <!-- ==================== ESKI STILLAR =====================
         Quyidagilar hali eski layoutlarда ishlatiladi. 2-bosqichda
         o'sha ekranlar ham yangi tizimga o'tgach olib tashlanadi.
         Hozir o'chirsak — o'sha ekranlar yig'ilmay qoladi. -->

    <style name="MenuCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="cardCornerRadius">@dimen/r_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="MenuCardInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/sp_4</item>
    </style>

    <style name="MenuIconWrap">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
    </style>

    <style name="MenuIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="MenuCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sp_3</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <style name="MenuCardSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_gray</item>
    </style>
</resources>
