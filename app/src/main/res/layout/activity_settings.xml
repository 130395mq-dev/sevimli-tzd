<?xml version="1.0" encoding="utf-8"?>
<!--
  SOZLAMALAR — 6.6 dizayni.

  MUHIM: birorta funksiya olib tashlanmadi va qo'shilmadi. Barcha ID lar
  avvalgidek: inLogin, inPassword, btnLogin, loginError, fnList, inToken,
  btnSaveToken, btnOrg, swUlgurji, storeList, loading.

  O'zgargani — joylashuv: ilgari hamma bo'lim bitta uzun scrollда ochiq
  turardi va xodim kerakli joyni izlab aylantirar edi. Endi 5 ta bo'lim
  yig'ilgan holda turadi, bosilganda O'SHA YERDA ochiladi. Yangi ekran
  ham, yangi navigatsiya ham yo'q.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- ==================== SARLAVHA ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- 48dp teginish maydoni: qo'lqop bilan ham beriladi -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/j_ic_back"
            app:tint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Orqaga" />

        <TextView
            style="@style/J.HeadTitle"
            android:layout_marginStart="4dp"
            android:text="Sozlamalar" />
    </LinearLayout>

    <!-- ==================== 1-BOSQICH: MENEJER KIRISHI ==================== -->
    <ScrollView
        android:id="@+id/loginStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <!-- Ilovaning O'Z logosi. Oq fonda och yashil ko'rinmasligi
                 uchun to'q yashil plitka ustiga qo'yilgan. -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/j_logo_tile">

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo"
                    android:contentDescription="Jamlov" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="Menejer kirishi"
                android:textColor="@color/text_dark"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                style="@style/J.Sub"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="26dp"
                android:text="Sozlamani faqat menejer o'zgartiradi" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/j_ic_user"
                    app:tint="#9BB3A7"
                    android:contentDescription="Login" />

                <EditText
                    android:id="@+id/inLogin"
                    style="@style/J.Field"
                    android:hint="Login"
                    android:inputType="text"
                    android:paddingStart="48dp"
                    android:autofillHints="username" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/j_ic_lock"
                    app:tint="#9BB3A7"
                    android:contentDescription="Parol" />

                <EditText
                    android:id="@+id/inPassword"
                    style="@style/J.Field"
                    android:hint="Parol"
                    android:inputType="textPassword"
                    android:paddingStart="48dp"
                    android:paddingEnd="52dp"
                    android:autofillHints="password" />

                <!-- Parolni ko'rish: xodim uzun parolni xato yozganini
                     tekshira olsin, qayta-qayta urinmasin. -->
                <ImageView
                    android:id="@+id/btnEye"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:padding="14dp"
                    android:src="@drawable/j_ic_eye_off"
                    app:tint="#9BB3A7"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Parolni ko'rsatish" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/J.Btn.Primary"
                android:layout_marginTop="20dp"
                android:text="Kirish" />

            <TextView
                android:id="@+id/loginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/warning"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== 2-BOSQICH: SOZLAMALAR ==================== -->
    <ScrollView
        android:id="@+id/storeStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ==== 1. BO'LIMLAR ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowFn"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_sections"
                        app:tint="@color/brand"
                        android:contentDescription="Bo'limlar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="Bo'limlar" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="Dashboardда ko'rinadigan bo'limlar" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrFn"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="Ochish" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxFn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <TextView style="@style/J.Sub"
                        android:layout_marginBottom="4dp"
                        android:text="«Просмотр товара» doim ko'rinadi" />

                    <LinearLayout
                        android:id="@+id/fnList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 2. QURILMA ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowDev"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_device"
                        app:tint="@color/brand"
                        android:contentDescription="Qurilma" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="Qurilma" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="Qurilma tokeni" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrDev"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="Ochish" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/inToken"
                        style="@style/J.Field"
                        android:hint="Qurilma tokeni (admin paneldan)"
                        android:inputType="text"
                        android:autofillHints="password" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveToken"
                        style="@style/J.Btn.Primary"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="Tokenni saqlash" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 3. TASHKILOT ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowOrg"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_org"
                        app:tint="@color/brand"
                        android:contentDescription="Tashkilot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="Tashkilot" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="Yuridik shaxsni tanlash" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrOrg"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="Ochish" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxOrg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrg"
                        style="@style/J.Btn.Soft"
                        android:text="Organizatsiyani tanlash" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 4. NARX TURI ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowPrice"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_price"
                        app:tint="@color/brand"
                        android:contentDescription="Narx turi" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="Narx turi" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="Chakana / Ulgurji" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrPrice"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="Ochish" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView style="@style/J.Sub"
                        android:layout_marginBottom="8dp"
                        android:text="Optom filialда yoqing — ценник ulgurji narxда chiqadi. Boshqasida o'chiq (chakana)." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/J.Body" android:text="Ulgurji narx (оптом)" />
                            <TextView style="@style/J.Sub"
                                android:layout_marginTop="2dp"
                                android:text="optom savdo filiali uchun" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swUlgurji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ==== 5. OMBOR (SKLAD) ==== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:background="@drawable/j_card">

                <LinearLayout
                    android:id="@+id/rowStore"
                    style="@style/J.Row"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        style="@style/J.IconBox"
                        android:src="@drawable/j_ic_store"
                        app:tint="@color/brand"
                        android:contentDescription="Ombor" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView style="@style/J.Body.Bold" android:text="Ombor" />
                        <TextView style="@style/J.Sub"
                            android:layout_marginTop="2dp"
                            android:text="Qurilma qaysi skladga ishlaydi" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrStore"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#9BB3A7"
                        android:contentDescription="Ochish" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/boxStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/J.Sub"
                        android:layout_marginBottom="6dp"
                        android:text="Tanlangan sklad barcha bo'limga amal qiladi" />

                    <LinearLayout
                        android:id="@+id/storeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />
</LinearLayout>
